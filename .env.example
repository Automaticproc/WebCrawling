APP_ADDR=:43123
MYSQL_DSN=catalog:catalog@tcp(127.0.0.1:3306)/catalog?parseTime=true&charset=utf8mb4&loc=UTC&clientFoundRows=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
SESSION_SECRET=replace-with-a-long-random-string
WEB_ORIGIN=http://127.0.0.1:43124
SYNC_DELAY_MS=400
COOKIE_SECURE=false
TZ=Asia/Hong_Kong

# 下载功能
DOWNLOAD_DIR=downloads
# 留空则从 PATH 查找 ffmpeg
FFMPEG_PATH=
# 留空则自动查找 Chrome / Edge / Chromium；容器里可指向 /usr/bin/chromium
DOWNLOAD_BROWSER=
# 可选：连接一个已经开着的 Chrome 调试端口（复用登录态），例如 9222
DOWNLOAD_BROWSER_PORT=
DOWNLOAD_BROWSER_TIMEOUT_SEC=45
DOWNLOAD_CONCURRENCY=8
# 浏览器用户目录；留空默认 <DOWNLOAD_DIR>/.browser-profile，登录态可跨进程复用
DOWNLOAD_BROWSER_PROFILE=
# 可选：直接注入 Cookie（k=v; k2=v2），适合不想存密码、已有登录态的场景
DOWNLOAD_COOKIE=
# 可选：自动登录（表单登录；验证码/短信/2FA 仍需人工）
# 全局兜底；平台管理里配置的登录信息优先
DOWNLOAD_LOGIN_URL=
DOWNLOAD_USERNAME=
DOWNLOAD_PASSWORD=
DOWNLOAD_LOGIN_USER_SELECTOR=
DOWNLOAD_LOGIN_PASSWORD_SELECTOR=
DOWNLOAD_LOGIN_SUBMIT_SELECTOR=
